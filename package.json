{
  "name": "kadr.admin",
  "version": "1.0.0",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "serve": "npm-run-all --parallel serve-client serve-server",
    "serve-client": "vue-cli-service serve --port 8081",
    "serve-server": "node server.js",
    "build": "vue-cli-service build",
    "watch": "vue-cli-service build --watch",
    "start": "nodemon server.js",
    "prisma:pull": "npx prisma db pull && npx prisma generate",
    "prisma:push": "npx prisma db push",
    "seed:notifications": "node scripts/seedNotificationTemplates.js",
    "seed:notifications:force": "node scripts/seedNotificationTemplates.js -- --force",
    "lint": "vue-cli-service lint",
    "test": "node --test tests/**/*.test.js",
    "docker:up": "docker compose up --build",
    "docker:up:detached": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api",
    "docker:shell": "docker compose exec api sh",
    "docker:create-admin": "docker compose exec api node scripts/createMasterAdmin.js",
    "create-admin": "node scripts/createMasterAdmin.js",
    "postinstall": "prisma generate",
    "electron:dev": "npm-run-all --parallel serve-client serve-server electron:launch",
    "electron:launch": "wait-on http://127.0.0.1:3000/health tcp:localhost:8081 && env -u ELECTRON_RUN_AS_NODE ELECTRON_DEV_URL=http://localhost:8081/admin/ ./node_modules/.bin/electron .",
    "electron:pack": "prisma generate && npm run build && KADR_DESKTOP=1 electron-builder --mac",
    "electron:pack:dir": "prisma generate && npm run build && KADR_DESKTOP=1 electron-builder --mac dir",
    "build:mobile": "vue-cli-service build --mode mobile",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "mobile:pack": "npm run build:mobile && npm run cap:sync"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/network": "^6.0.4",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@fortawesome/fontawesome-free": "^5.11.2",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@fullcalendar/vue3": "^6.1.21",
    "@guillaumebriday/vue-scroll-progress-bar": "^0.5.0",
    "@prisma/client": "^5.22.0",
    "@tinymce/tinymce-vue": "^5.1.1",
    "tinymce": "^5.10.9",
    "@vue/compat": "^3.5.42",
    "autoprefixer": "^10.5.2",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.6",
    "bootstrap-vue": "^2.23.1",
    "capacitor-secure-storage-plugin": "^0.10.0",
    "cheerio": "^1.2.0",
    "codemirror": "^5.65.21",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "core-js": "^3.49.0",
    "css-loader": "^6.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "flatpickr": "^4.6.13",
    "fs": "^0.0.1-security",
    "google-auth-library": "^11.0.2",
    "googleapis": "^144.0.0",
    "helmet": "^8.3.0",
    "jquery": "^3.4.1",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.18.1",
    "moment": "^2.24.0",
    "mysql": "^2.18.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.9.16",
    "nodemon": "^3.1.9",
    "owl.carousel": "^2.3.4",
    "postcss-loader": "^3.0.0",
    "puppeteer": "^24.43.1",
    "ramda": "^0.27.0",
    "register-service-worker": "^1.6.2",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.6",
    "signature_pad": "^5.0.4",
    "smooth-scrollbar": "^8.5.1",
    "striptags": "^3.2.0",
    "url-loader": "^4.0.1",
    "uuid": "^11.1.1",
    "vue": "^3.5.42",
    "vue-cookies": "^1.8.4",
    "vue-flatpickr-component": "^11.0.5",
    "vue-router": "^4.6.4",
    "vue-signature-pad": "^2.0.5",
    "vuex": "^4.1.0",
    "webpack": "^5.108.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.0.0",
    "@capacitor/cli": "^6.2.1",
    "@popperjs/core": "^2.0.0",
    "@types/node": "^22.10.1",
    "@vue/cli-plugin-babel": "^5.0.0",
    "@vue/cli-plugin-eslint": "^5.0.0",
    "@vue/cli-plugin-router": "^5.0.0",
    "@vue/cli-plugin-vuex": "^5.0.0",
    "@vue/cli-service": "^5.0.0",
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/eslint-config-standard": "^8.0.1",
    "bootstrap": "^4.6.1",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "eslint": "^8.0.0",
    "eslint-plugin-vue": "^9.2.0",
    "less": "^4.1.0",
    "less-loader": "^11.0.0",
    "lint-staged": "^9.5.0",
    "mutationobserver-shim": "^0.3.5",
    "npm-run-all": "^4.1.5",
    "portal-vue": "^2.1.6",
    "prisma": "^5.21.0",
    "sass": "^1.101.0",
    "sass-loader": "^12.6.0",
    "stylus": "^0.54.7",
    "stylus-loader": "^6.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vue-cli-plugin-bootstrap-vue": "^0.6.0",
    "vue-loader": "^17.4.2",
    "wait-on": "^8.0.5"
  },
  "build": {
    "extends": "electron-builder.yml"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "vue-cli-service lint",
      "git add"
    ]
  }
}
