{
  "appId": "live.kadr.portal",
  "appName": "Kadr Portal",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "android": {
    "path": "platforms/android"
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "androidScaleType": "CENTER_CROP"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
