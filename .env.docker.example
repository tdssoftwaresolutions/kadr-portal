# Copy to .env before running Docker:
#   cp .env.docker.example .env
#
# Then start the stack:
#   docker compose up --build

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# MySQL (matches docker-compose db service)
DATABASE_URL=mysql://kadr:kadr@db:3306/kadr_portal

# Public URLs (change if you expose the app on another host/port)
BASE_URL=http://localhost:3000
PORTAL_APP_URL=http://localhost:3000/admin
PUBLIC_WEBSITE_URL=http://localhost:3000

# Required JWT / signing secrets — change before any real deployment
# Use KEY=value only (no spaces around =, no trailing semicolons)
SECRET_KEY=change-me-docker-dev-secret-key-min-32-chars
REFRESH_SECRET_KEY=change-me-docker-refresh-secret-min-32-chars
SIGN_SECRET_KEY=change-me-docker-sign-secret-min-32-chars
# AES-256 key (64 hex chars = 32 bytes) for encrypting P0 data at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=change-me-64-hex-chars-32-byte-aes-key

# Cookies: 0 for local HTTP, 1 for HTTPS (ngrok / EC2 with TLS)
COOKIE_SECURE=0

# Static assets (enabled by default in Docker)
SERVE_ADMIN_STATIC=1
SERVE_WEBSITE_STATIC=1

# Security
KADR_STRICT_ADMIN_PERMISSIONS=1
ALLOW_FAKE_PAYMENTS=0

# First admin bootstrap (used with scripts/createMasterAdmin.js)
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=ChangeMe123!
# ADMIN_NAME=Master Admin

# Optional: public contact form API key (marketing site contact page)
# WEBSITE_CONTACT_API_KEY=

# Optional: S3 uploads for file storage in production
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_REGION=ap-south-1

# Optional: email (SMTP) — required for password reset and welcome emails
# EMAIL_PROVIDER=smtp
# EMAIL_SMTP_HOST=smtp.hostinger.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_SECURE=true
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_FROM=noreply@kadr.live

# Optional: Google Calendar integration
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: Zoom meetings
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_ACCOUNT_ID=

# Optional: SMS / WhatsApp (Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SENDER_NUMBER=
# TWILIO_WHATSAPP_FROM=

# Payment gateway — see .env.payment.example for full provider credentials
PAYMENT_GATEWAY=payu
PAYU_ENV=test
# PAYU_MERCHANT_KEY=
# PAYU_MERCHANT_SALT=

# Operational timezone for cron (reminders, subscription expiry).
# The SPA uses each user's profile/device timezone for display.
APP_TIMEZONE=Asia/Kolkata

# Critical error alerting — comma-separated list of tech team emails
ALERT_TECH_TEAM_EMAILS=test@gmail.com
ALERT_THROTTLE_MINUTES=5
ALERT_500_THRESHOLD=5
ALERT_500_WINDOW_MINUTES=5

