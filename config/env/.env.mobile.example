# Copy to .env.mobile.local for local mobile builds (do not commit secrets).

# Production API (required for bundled mobile app)
VUE_APP_API_BASE_URL=https://your-domain.com

# Build flag — set by npm run build:mobile
VUE_APP_CAPACITOR=1

# Server CORS (optional extra origins, comma-separated)
# MOBILE_CORS_ORIGINS=https://your-domain.com

# Push (server-side, when enabling FCM)
# PUSH_FCM_SERVER_KEY=
