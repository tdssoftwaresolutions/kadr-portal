# Copy this file to ONE of these locations:
#   1. Same folder as Kadr Portal.app   →  /Applications/.env
#   2. App support folder               →  ~/Library/Application Support/kadr.admin/.env
#
# Required for database and integrations.

PORT=47821
DATABASE_URL="mysql://user:password@host:3306/kadr"
BASE_URL=http://127.0.0.1:47821
PORTAL_APP_URL=http://127.0.0.1:47821

# Security & platform
KADR_STRICT_ADMIN_PERMISSIONS=1
ALLOW_FAKE_PAYMENTS=0
REQUEST_BODY_LIMIT=4mb
S3_BUCKET_NAME=your-bucket-name
S3_REGION=us-east-1
WEBSITE_CONTACT_API_KEY=generate-a-random-key

# Add your existing API keys, JWT secrets (SECRET_KEY, REFRESH_SECRET_KEY, SIGN_SECRET_KEY), AWS, Google OAuth, etc.
